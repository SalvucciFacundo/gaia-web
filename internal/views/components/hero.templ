package components

templ Hero() {
	<section class="relative min-h-screen flex items-center justify-center overflow-hidden bg-grid pt-24 pb-16">
		<!-- Ambient glows -->
		<div class="bg-glow-orb bg-neon-cyan top-[-10%] left-[-5%] animate-pulse-glow"></div>
		<div class="bg-glow-orb bg-neon-emerald bottom-[-10%] right-[-5%]" style="animation: pulse-glow 5s ease-in-out infinite 1s;"></div>
		<div class="bg-glow-orb bg-neon-purple top-[40%] right-[30%] opacity-10"></div>

		<div class="relative z-10 max-w-5xl mx-auto px-6 text-center">
			<!-- Badge -->
			<div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full glass-card border border-border-neon-cyan/30 text-neon-cyan text-xs font-mono mb-8">
				<span class="w-1.5 h-1.5 rounded-full bg-neon-cyan animate-pulse"></span>
				v2.0 · Go 1.23+ · 19 LLM Providers · MIT License
			</div>

			<!-- Title -->
			<h1 class="text-5xl md:text-7xl lg:text-8xl font-extrabold tracking-tight mb-6 leading-tight">
				<span class="text-gradient">GAIA</span>
			</h1>

			<!-- Tagline -->
			<p class="text-xl md:text-2xl text-text-secondary max-w-3xl mx-auto mb-4 leading-relaxed">
				<span class="text-text-primary font-semibold">Go Autonomous Intelligence Agent</span>
				— A <span class="text-neon-cyan font-medium">programming-first</span> autonomous AI agent in Go.
				Single binary, zero external dependencies, Cyberpunk TUI, and real-time Web Dashboard.
			</p>

			<!-- Subtitle -->
			<p class="text-base text-text-muted max-w-3xl mx-auto mb-10">
				Spec-Driven Development (SDD) · 19 LLM Providers with Credential Pool · Web Dashboard (`templ-islands`) ·
				12+ Specialized Subagents · PolicyGuard Security · Knowledge Graph Memory
			</p>

			<!-- CTAs -->
			<div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-12">
				<a
					href="#quickstart"
					class="w-full sm:w-auto px-8 py-3.5 rounded-xl font-semibold text-sm bg-neon-cyan/10 border border-neon-cyan text-neon-cyan hover:glow-cyan hover:bg-neon-cyan/20 transition-all duration-300"
				>
					🚀 Quick Start
				</a>
				<a
					href="https://github.com/SalvucciFacundo/gaia"
					target="_blank"
					rel="noopener noreferrer"
					class="w-full sm:w-auto px-8 py-3.5 rounded-xl font-semibold text-sm glass-card border border-border-subtle text-text-primary hover:border-text-muted transition-all duration-300 flex items-center justify-center gap-2"
				>
					<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
						<path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"></path>
					</svg>
					View on GitHub
				</a>
			</div>

			<!-- Hero Banner Image Showcase -->
			<div class="max-w-4xl mx-auto rounded-2xl overflow-hidden glass-card border border-border-neon-cyan/30 shadow-2xl p-2 hover:glow-cyan transition-all duration-500 mb-12">
				<img
					src="/static/img/hero_banner.png"
					alt="GAIA — Go Autonomous Intelligence Agent"
					class="w-full h-auto rounded-xl object-cover shadow-inner"
					loading="eager"
				/>
			</div>

			<!-- Terminal Preview -->
			<div class="max-w-2xl mx-auto glass-card rounded-2xl p-1 border-border-subtle text-left shadow-2xl">
				<div class="flex items-center justify-between px-4 py-3 border-b border-border-subtle">
					<div class="flex items-center gap-2">
						<span class="w-3 h-3 rounded-full bg-red-500/60"></span>
						<span class="w-3 h-3 rounded-full bg-yellow-500/60"></span>
						<span class="w-3 h-3 rounded-full bg-green-500/60"></span>
						<span class="text-xs text-text-muted ml-2 font-mono">terminal</span>
					</div>
					<button
						onclick="copyCode(this, 'curl -fsSL https://raw.githubusercontent.com/SalvucciFacundo/gaia/main/install.sh | bash')"
						class="text-xs font-mono text-text-muted hover:text-neon-cyan transition-colors"
					>
						copy
					</button>
				</div>
				<div class="p-5 font-mono text-xs sm:text-sm leading-relaxed overflow-x-auto">
					<div class="text-text-muted"># Quick install (Linux &amp; macOS)</div>
					<div>
						<span class="text-neon-emerald">$</span> <span class="text-text-primary">curl -fsSL https://raw.githubusercontent.com/SalvucciFacundo/gaia/main/install.sh | bash</span>
					</div>
					<div class="mt-2 text-text-muted"># Launch Cyberpunk TUI or Web Dashboard</div>
					<div>
						<span class="text-neon-emerald">$</span> <span class="text-text-primary">gaia</span>
						<span class="text-text-muted ml-3"># Interactive Terminal UI</span>
					</div>
					<div>
						<span class="text-neon-emerald">$</span> <span class="text-text-primary">gaia serve 8080</span>
						<span class="text-text-muted ml-3"># Real-time Web UI Dashboard</span>
					</div>
				</div>
			</div>

			<!-- Scroll indicator -->
			<div class="mt-16 flex flex-col items-center gap-2 text-text-muted animate-float">
				<span class="text-xs font-mono">scroll</span>
				<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
					<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"></path>
				</svg>
			</div>
		</div>
	</section>
}
