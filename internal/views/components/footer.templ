								Subagent System
							</a>
						</li>
						<li>
							<a href="https://github.com/SalvucciFacundo/gaia/blob/main/docs/configuration.md" target="_blank" rel="noopener noreferrer" class="hover:text-neon-cyan transition-colors">
								Configuration
							</a>
						</li>
					</ul>
				</div>

				<!-- Community -->
				<div>
					<h4 class="text-xs font-semibold text-text-muted uppercase tracking-wider mb-4">Community</h4>
					<ul class="space-y-2 text-sm text-text-secondary">
						<li>
							<a href="https://github.com/SalvucciFacundo/gaia" target="_blank" rel="noopener noreferrer" class="hover:text-neon-cyan transition-colors">
