package docs

import (
	"fmt"
	"github.com/SalvucciFacundo/gaia-web/internal/docs"
	"github.com/SalvucciFacundo/gaia-web/internal/views/components"
	"github.com/SalvucciFacundo/gaia-web/internal/views/layout"
)

templ Page(doc *docs.Doc, categories []docs.DocCategory) {
	@layout.Base(fmt.Sprintf("GAIA Docs — %s", doc.Metadata.Title), doc.Metadata.Description) {
		@components.Navbar("docs")

		<div class="min-h-screen pt-20 pb-16 bg-grid">
			<!-- Ambient glows -->
			<div class="bg-glow-orb bg-neon-cyan top-20 left-0 opacity-5"></div>
			<div class="bg-glow-orb bg-neon-purple bottom-20 right-0 opacity-5"></div>

			<!-- Mobile Sidebar Toggle -->
			<div class="lg:hidden max-w-7xl mx-auto px-6 mb-4">
				<button
					id="mobile-docs-toggle"
					type="button"
					onclick="toggleDocsSidebar()"
					class="w-full flex items-center justify-between px-4 py-2.5 rounded-xl glass-card border border-border-subtle text-xs font-mono text-text-primary"
				>
					<span class="flex items-center gap-2">
						<span class="text-neon-cyan">☰</span>
						<span>Docs Menu: <strong class="text-neon-cyan">{ doc.Metadata.Title }</strong></span>
					</span>
					<span class="text-text-muted">Tap to browse</span>
				</button>
			</div>

			<div class="max-w-7xl mx-auto px-6">
				<div class="flex flex-col lg:flex-row gap-8 items-start">
					<!-- Sidebar -->
					<div id="docs-sidebar-container" class="hidden lg:block w-full lg:w-72 flex-shrink-0">
						@Sidebar(categories, doc.Metadata.Slug)
					</div>

					<!-- Main Content Body -->
					<main id="docs-body" class="flex-1 min-w-0 w-full glass-card rounded-2xl p-6 sm:p-10 border border-border-subtle shadow-xl">
						@Content(doc)
					</main>
				</div>
			</div>
		</div>

		@components.Footer()
	}
}
