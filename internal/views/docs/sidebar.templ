package docs

import (
	"fmt"
	"github.com/SalvucciFacundo/gaia-web/internal/docs"
)

templ Sidebar(categories []docs.DocCategory, currentSlug string) {
	<aside class="w-full lg:w-72 flex-shrink-0 lg:sticky lg:top-20 lg:h-[calc(100vh-5rem)] lg:overflow-y-auto pr-0 lg:pr-4 pb-8 lg:pb-12 text-sm">
		<!-- Search / Filter bar (Visual enhancement) -->
		<div class="mb-6">
			<div class="relative">
				<input
					type="text"
					id="doc-search"
					placeholder="Filter documentation..."
					onkeyup="filterDocs(this.value)"
					class="w-full px-3.5 py-2 rounded-xl bg-bg-surface/80 border border-border-subtle text-xs text-text-primary placeholder:text-text-muted focus:outline-none focus:border-neon-cyan/50 focus:glow-cyan transition-all"
				/>
				<svg class="w-3.5 h-3.5 text-text-muted absolute right-3 top-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
				</svg>
			</div>
		</div>

		<!-- Categories List -->
		<div class="space-y-6" id="docs-sidebar-nav">
			for _, cat := range categories {
				<div class="doc-category-group">
					<h3 class="text-xs font-mono font-bold text-text-muted uppercase tracking-wider mb-2.5 flex items-center gap-1.5 px-2">
						<span>{ cat.Icon }</span>
						<span>{ cat.Name }</span>
					</h3>
					<ul class="space-y-1">
						for _, d := range cat.Docs {
							<li class="doc-item" data-title={ d.Title } data-category={ cat.Name }>
								if d.Slug == currentSlug {
									<a
										href={ templ.SafeURL(fmt.Sprintf("/docs/%s", d.Slug)) }
										class="flex items-center justify-between px-3 py-2 rounded-lg bg-neon-cyan/10 border border-border-neon-cyan text-neon-cyan font-semibold text-xs transition-all glow-cyan"
									>
										<span class="flex items-center gap-2 truncate">
											<span class="text-sm">{ d.Icon }</span>
											<span class="truncate">{ d.Title }</span>
										</span>
										<span class="w-1.5 h-1.5 rounded-full bg-neon-cyan animate-pulse"></span>
									</a>
								} else {
									<a
										href={ templ.SafeURL(fmt.Sprintf("/docs/%s", d.Slug)) }
										class="flex items-center gap-2 px-3 py-2 rounded-lg text-text-secondary hover:text-text-primary hover:bg-bg-card-hover border border-transparent hover:border-border-subtle text-xs transition-colors"
									>
										<span class="text-sm">{ d.Icon }</span>
										<span class="truncate">{ d.Title }</span>
									</a>
								}
							</li>
						}
					</ul>
				</div>
			}
		</div>
	</aside>
}
