package docs

import (
	"fmt"
	"github.com/SalvucciFacundo/gaia-web/internal/docs"
)

templ Content(doc *docs.Doc) {
	<article class="flex-1 min-w-0 max-w-4xl mx-auto py-2">
		<!-- Breadcrumbs & Meta header -->
		<div class="mb-8 pb-6 border-b border-border-subtle">
			<div class="flex items-center gap-2 text-xs font-mono text-text-muted mb-4">
				<a href="/docs" class="hover:text-neon-cyan transition-colors">Documentation</a>
				<span>/</span>
				<span class="text-text-secondary">{ doc.Metadata.Category }</span>
				<span>/</span>
				<span class="text-neon-cyan">{ doc.Metadata.Title }</span>
			</div>

			<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
				<div>
					<div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-neon-cyan/10 border border-neon-cyan/20 text-neon-cyan text-xs font-mono mb-3">
						<span>{ doc.Metadata.Icon }</span>
						<span>{ doc.Metadata.Category }</span>
					</div>
					<h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-text-primary mb-2">
						<span class="text-gradient">{ doc.Metadata.Title }</span>
					</h1>
					<p class="text-base text-text-secondary leading-relaxed">
						{ doc.Metadata.Description }
					</p>
				</div>
				<div class="flex-shrink-0">
					<a
						href={ templ.SafeURL(fmt.Sprintf("https://github.com/SalvucciFacundo/gaia/blob/main/docs/%s", doc.Metadata.FileName)) }
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl glass-card border border-border-subtle hover:border-border-neon-cyan/40 text-xs font-mono text-text-secondary hover:text-text-primary transition-all duration-300"
					>
						<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
							<path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"></path>
						</svg>
						Edit on GitHub
					</a>
				</div>
			</div>
		</div>

		<!-- Main Rendered Markdown Content -->
		<div class="doc-markdown-body text-text-primary text-sm sm:text-base leading-relaxed space-y-4">
			@templ.Raw(string(doc.HTML))
		</div>

		<!-- Prev / Next Navigation -->
		<div class="mt-16 pt-8 border-t border-border-subtle grid grid-cols-1 sm:grid-cols-2 gap-4">
			if doc.Prev != nil {
				<a
					href={ templ.SafeURL(fmt.Sprintf("/docs/%s", doc.Prev.Slug)) }
					class="group glass-card rounded-xl p-4 border border-border-subtle hover:border-border-neon-cyan/40 hover:bg-bg-card-hover transition-all duration-300 flex items-center gap-3"
				>
					<span class="text-lg text-neon-cyan group-hover:-translate-x-1 transition-transform">←</span>
					<div class="min-w-0">
						<div class="text-xs font-mono text-text-muted">Previous</div>
						<div class="font-semibold text-text-primary text-sm truncate group-hover:text-neon-cyan transition-colors">
							{ doc.Prev.Title }
						</div>
					</div>
				</a>
			} else {
				<div></div>
			}

			if doc.Next != nil {
				<a
					href={ templ.SafeURL(fmt.Sprintf("/docs/%s", doc.Next.Slug)) }
					class="group glass-card rounded-xl p-4 border border-border-subtle hover:border-border-neon-emerald/40 hover:bg-bg-card-hover transition-all duration-300 flex items-center justify-between gap-3 text-right"
				>
					<div class="min-w-0 flex-1">
						<div class="text-xs font-mono text-text-muted">Next</div>
						<div class="font-semibold text-text-primary text-sm truncate group-hover:text-neon-emerald transition-colors">
							{ doc.Next.Title }
						</div>
					</div>
					<span class="text-lg text-neon-emerald group-hover:translate-x-1 transition-transform">→</span>
				</a>
			}
		</div>
	</article>
}
